{
  "name": "synthesis-hallucination-baseline",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Measure Fase B synthesis hallucination rate before implementation. Spec v1.4.",
  "scripts": {
    "preflight": "tsx --env-file=../../.env.local src/preflight.ts",
    "resample": "tsx --env-file=../../.env.local src/resample-signals.ts",
    "resample:stats": "tsx --env-file=../../.env.local src/resample-signals.ts --stats",
    "select": "tsx --env-file=../../.env.local src/select-groups.ts",
    "generate": "tsx --env-file=../../.env.local src/generate-synthesis.ts",
    "prelabel": "tsx --env-file=../../.env.local src/prelabel.ts",
    "export": "tsx --env-file=../../.env.local src/export-for-labeling.ts",
    "analyze": "tsx --env-file=../../.env.local src/analyze-results.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@supabase/supabase-js": "^2.48.0",
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
